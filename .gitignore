# =========================================================================
# FRONTEND (Next.js / Node.js)
# =========================================================================

# Dependencies (라이브러리 및 패키지)
/front/node_modules/
/front/.pnp
.pnp.*
/front/.yarn/*
!/front/.yarn/patches
!/front/.yarn/plugins
!/front/.yarn/releases
!/front/.yarn/versions

# Next.js 빌드 및 산출물
/front/.next/
/front/out/
/front/build/
/front/*.tsbuildinfo
/front/next-env.d.ts

# Testing (테스트 결과 리포트)
/front/coverage/

# Debug Logs (디버그 로그)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel 배포 관련 임시 파일
/front/.vercel/


# =========================================================================
# BACKEND (FastAPI / Python)
# =========================================================================

# Virtual Environment (파이썬 가상환경)
**/venv/
**/.venv/
venv/
.venv/

# Python Cache (컴파일 임시 파일)
**/__pycache__/
**/*.pyc
__pycache__/
*.pyc

# Local Database (로컬 테스트용 SQLite 등 임시 DB)
*.db
*.sqlite3

# Test Cache
.pytest_cache/

# Large Local Datasets (로컬 수집 대용량 데이터 파일)
back/data/관광정보_메인_장소_데이터.csv


# =========================================================================
# COMMON & SECURITY (공통 및 보안 필수 항목)
# =========================================================================

# IDE / Editor Settings
.vscode/
.idea/

# OS Generated Files (운영체제 임시 파일)
.DS_Store
Thumbs.db

# SSL/TLS Certificates (인증서 키 파일)
*.pem
*.key

# Environment Variables (환경 변수 파일)
.env
.env.*
!.env.example