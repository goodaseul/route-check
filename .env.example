# =========================================================================
# BACKEND SYSTEM CONFIG
# =========================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000

# =========================================================================
# THIRD-PARTY API KEYS
# =========================================================================

# 1. 한국관광공사 (Tour API) 국문 관광정보 서비스
# 공공데이터포털(data.go.kr)에서 발급받은 '디코딩' 일반 인증키 입력
TOUR_API_DECODE_KEY=your_tour_api_decode_key_here

# 2. AI / LLM API KEYS (RAG 파이프라인 구현 시 활성화)
OPENAI_API_KEY=your_openai_api_key_here

# 3. KAKAO MAP API
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_map_javascript_key_here

# =========================================================================
# DATABASE / VECTOR STORE (향후 확장용)
# =========================================================================
VECTOR_DB_URL=your_vector_db_url_here

# Supabase PostgreSQL Connection Pooler URL (IPv4용 포트 6543)
# 예시: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.cboofciedcpjucsmoqdj:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 어드민 보안 인증용 JWT 비밀값
JWT_SECRET=super-secret-jwt-key-for-route-check-admin-1234567890